# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host-side port mapping only — the container always listens on 5432 internally.
# 5432/5433/5434 are taken by other local projects on this machine, so 5435 is used here.
POSTGRES_HOST_PORT=5435

# --- App ---
APP_HOST_PORT=8080

# Min 256 bits for HS256. Generate your own; do not reuse this placeholder.
JWT_SECRET=change-me-min-256-bits-0123456789abcdef0123456789abcdef
JWT_EXPIRATION_MS=86400000

# --- Running the app without Docker, against the compose Postgres ---
# If you start only `db` via docker compose (host port 5435) and run the app
# locally with `.\mvnw.cmd spring-boot:run`, point it at the host-mapped port:
# DB_URL=jdbc:postgresql://localhost:5435/ecommerce
